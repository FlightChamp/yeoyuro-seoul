# =====================================================================
#  여유로 서울 (Yeoyuro Seoul) .gitignore
#  원칙: 코드·마스터·리포트는 커밋한다. 원본 데이터와 중간 산출물은 제외한다.
#        마스터(data/master)는 프로젝트 정의의 일부이므로 반드시 포함한다.
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- 가상환경 ----------
.venv/
venv/
env/
.conda/

# ---------- 환경변수·비밀 ----------
.env
.env.*
*.pem
*.key
secrets.*
credentials.*

# ---------- 원본 데이터 (재배포 제약, 약 143MB) ----------
# 서울교통공사 공공데이터. 출처에서 직접 내려받아 data/raw 아래에 두고 재현한다.
data/raw/**
!data/raw/**/.gitkeep

# ---------- 파이프라인 중간·최종 산출물 (스크립트로 재생성, 약 103MB) ----------
data/staging/**
data/interim/**
data/marts/**
!data/staging/.gitkeep
!data/interim/.gitkeep
!data/marts/.gitkeep

# ---------- 마스터는 커밋한다 (프로젝트 정의) ----------
!data/master/**

# ---------- 학습된 모델 (약 33MB, 재학습 가능) ----------
models/**
!models/.gitkeep

# ---------- 리포트: 문서·표·그림은 커밋, 대용량 원시 결과는 제외 ----------
reports/**/*.parquet
reports/**/*.csv.gz
# 경로 평가 상세는 행 수가 많아 제외한다(요약 CSV 는 커밋)
reports/route/route_eval_cases*.csv
reports/route/route_eval_detail*.csv

# ---------- 실험 추적 ----------
mlruns/
.mlflow/

# ---------- OS / 에디터 ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# ---------- 임시 ----------
*.log
*.tmp
tmp/
scratch/

# ---------- 배포용: 앱이 런타임에 읽는 마트만 커밋한다 ----------
# 앱은 대용량 마트(congestion_training_mart 706,678행, 승하차 마트 15,957,680행)를
# 읽지 않는다. 아래 파일만 있으면 로컬과 동일한 기능이 동작한다.
!data/marts/route_edge_mart.*
!data/marts/transfer_edge_mart.*
!data/marts/congestion_edge_lookup.*
!data/marts/congestion_station_profile.*
!data/marts/transfer_tip_mart.*
!data/marts/event_did_mart.*
!data/marts/event_spike_mart.*
!data/marts/headway_station_30min.*
!data/marts/headway_line_30min.*
!data/marts/route_evaluation_mart_*.*
!data/marts/route_evaluation_summary_*.*

# Excel 임시 잠금 파일 (워크북을 열면 생성됨)
~$*.xlsx

# v2 — 앱·CI 가 읽는 작은 mart 만 커밋 (재생성 비용이 크거나 원본이 없는 경우)
!data/marts/v2/
!data/marts/v2/demand_station_hour.parquet
!data/marts/v2/od_shiftability_mart.parquet
!data/marts/v2/mobility_atlas_mart.parquet
!data/marts/v2/event_scenario_mart.parquet
!data/marts/v2/line9/
!data/marts/v2/line9/**
!data/marts/v2/demand_station_hour_oa.parquet

# 노선도 미리보기 (감시 모드가 매번 새로 만듦)
reports/figures/map_live/
reports/figures/map_live.html
reports/figures/vector_map_preview_v26*.png

# 앱 데이터 폴더의 생성 부산물 (노선도 가져오기 중간 파일)
data/app_v26/reports/
